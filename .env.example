# =========================
# SyncDoc Environment
# =========================

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/syncdoc

# Authentication
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:5173

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173